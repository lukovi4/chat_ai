# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Local smoke define files — the canonical config path (dart-define-from-file).
# Project-specific values; never commit.
/firebase.android.local.json
/firebase.ios.local.json
# Defensive: native Firebase config files are NOT the primary path here, but if
# a contributor adds them they must never be committed either.
**/GoogleService-Info.plist
**/google-services.json
lib/firebase_options.dart
.firebaserc
# The example is an app but its lockfile is intentionally not committed here.
/pubspec.lock
